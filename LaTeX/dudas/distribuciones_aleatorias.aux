\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Curva de convergencia espacial del resolvedor de Poisson. La pendiente experimental de la regresión lineal log-log es de $2.006$, en perfecto acuerdo con el orden cuadrático teórico.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:conv_espacial}{{6}{9}{Curva de convergencia espacial del resolvedor de Poisson. La pendiente experimental de la regresión lineal log-log es de $2.006$, en perfecto acuerdo con el orden cuadrático teórico}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {VI.IV}Error en Resolvedores Iterativos: Decaimiento Exponencial (Jacobi)}{10}{subsection.6.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Decaimiento del error y residual en el método de Jacobi en función del número de iteraciones (pasos).}}{10}{table.3}\protected@file@percent }
\newlabel{tab:conv_iterativa}{{3}{10}{Decaimiento del error y residual en el método de Jacobi en función del número de iteraciones (pasos)}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Convergencia del resolvedor iterativo de Jacobi. Izquierda: evolución temporal en escala lineal que ilustra la amortiguación del error. Derecha: visualización en escala semilogarítmica donde se aprecia con toda claridad la tasa constante de decaimiento (línea recta) del residual hasta precisión de máquina ($10^{-16}$) y el plateau final del error $L_2$ debido al error sistemático de discretización de la rejilla.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:conv_iterativa}{{7}{11}{Convergencia del resolvedor iterativo de Jacobi. Izquierda: evolución temporal en escala lineal que ilustra la amortiguación del error. Derecha: visualización en escala semilogarítmica donde se aprecia con toda claridad la tasa constante de decaimiento (línea recta) del residual hasta precisión de máquina ($10^{-16}$) y el plateau final del error $L_2$ debido al error sistemático de discretización de la rejilla}{figure.7}{}}
