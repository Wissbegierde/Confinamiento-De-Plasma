\@writefile{toc}{\contentsline {section}{\numberline {VI}Análisis de Error y Validación Numérica}{6}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {VI.I}Convergencia Temporal: Integrador de Boris}{6}{subsection.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Errores máximos y orden de convergencia en función de $\Delta t$.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:conv_temporal}{{1}{7}{Errores máximos y orden de convergencia en función de $\Delta t$}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Análisis de convergencia temporal del integrador de Boris. Izquierda: Error máximo en posición en función de $\Delta t$ mostrando una pendiente experimental de $1.989$ en escala log-log. Derecha: Error relativo máximo en la energía total con una pendiente experimental de $2.000$, confirmando rigurosamente el segundo orden de convergencia ($\mathcal  {O}(\Delta t^2)$) del esquema.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:conv_temporal}{{4}{7}{Análisis de convergencia temporal del integrador de Boris. Izquierda: Error máximo en posición en función de $\Delta t$ mostrando una pendiente experimental de $1.989$ en escala log-log. Derecha: Error relativo máximo en la energía total con una pendiente experimental de $2.000$, confirmando rigurosamente el segundo orden de convergencia ($\mathcal {O}(\Delta t^2)$) del esquema}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {VI.II}Estabilidad Numérica: Límite Ciclotrónico}{7}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Trayectorias de giro Larmor integradas con Boris bajo tres resoluciones temporales distintas. Izquierda: régimen resuelto ($\Delta t = T_c/20$). Centro: régimen sub-resuelto pero estable ($\Delta t = T_c/4$). Derecha: régimen inestable y distorsionado ($\Delta t = 0.8 T_c$) donde se viola el límite de muestreo de Nyquist.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:estabilidad_orbita}{{5}{8}{Trayectorias de giro Larmor integradas con Boris bajo tres resoluciones temporales distintas. Izquierda: régimen resuelto ($\Delta t = T_c/20$). Centro: régimen sub-resuelto pero estable ($\Delta t = T_c/4$). Derecha: régimen inestable y distorsionado ($\Delta t = 0.8 T_c$) donde se viola el límite de muestreo de Nyquist}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {VI.III}Convergencia Espacial: Resolvedor de Poisson}{8}{subsection.6.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Error $L_2$ relativo del resolvedor de Poisson en función del espaciamiento de grilla $h$.}}{9}{table.2}\protected@file@percent }
